# Copy to .env.local and fill in. See deploy notes.

# 1) Session signing secret (required in production)
#    node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# 2) Google OAuth Client ID (public). No secret needed for the Google button flow.
#    Authorized JavaScript origins: https://your-domain.com  (+ http://localhost:3000)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_ID=""

# 3) Postgres connection string — REQUIRED in production (Neon / Supabase / Railway / RDS)
#    Example: postgres://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=""

# 4) Comma-separated emails that are automatically admins.
ADMIN_EMAILS="you@example.com"

# 5) Public base URL used in password-reset links (e.g. https://your-domain.com)
APP_URL=""

# 6) Optional: email delivery for "forgot password" + reminders.
#    Use Resend if you own a domain, otherwise Brevo with a verified single sender.
#    Resend: https://resend.com/api-keys
RESEND_API_KEY=""
#    Brevo: https://app.brevo.com/settings/keys/api  (verify a sender email first)
BREVO_API_KEY=""
#    Sender address. Resend needs a verified domain; Brevo accepts a verified email.
#    May include a display name, e.g. "日本語 <you@example.com>"
EMAIL_FROM=""

# 7) Optional: AI study coach (OpenAI-compatible). Works with OpenAI, OpenRouter, Groq, etc.
#    Without a key, a built-in rules-based coach is used instead.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# 8) Secures the daily reminder cron endpoint (/api/cron/reminder).
#    node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=""

# Copy to .env.local and fill in. See deploy notes.

# 1) Session signing secret (required in production)
#    node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# 2) Google OAuth Client ID (public). No secret needed for the Google button flow.
#    Authorized JavaScript origins: https://your-domain.com  (+ http://localhost:3000)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_ID=""

# 3) Postgres connection string — REQUIRED in production (Neon / Supabase / Railway / RDS)
#    Example: postgres://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=""

# 4) Comma-separated emails that are automatically admins.
ADMIN_EMAILS="you@example.com"

# 5) Public base URL used in password-reset links (e.g. https://your-domain.com)
APP_URL=""

# 6) Optional: email delivery for "forgot password" (https://resend.com)
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"

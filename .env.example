# Copy to .env.local and fill in. See README/deploy notes.

# 1) Session signing secret (required in production)
#    node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# 2) Google OAuth Client ID (public). No secret needed for the Google button flow.
#    Authorized JavaScript origins: https://your-domain.com  (+ http://localhost:3000)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_ID=""

# 3) Postgres connection string — REQUIRED in production (Neon / Supabase / Railway / RDS)
#    Example: postgres://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=""
